# Build output
/bin/
/dist/
# The binary when built into the repo root. Anchored so it cannot swallow
# cmd/iskeled/.
/iskeled

# Frontend
/web/node_modules/
/web/dist/*
!/web/dist/.gitkeep
/web/.vite/

# Test & coverage
*.out
*.test
coverage.html

# Local runtime data
/.data/
*.db
*.db-wal
*.db-shm
secret.key

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Build-time planning documents. The work they specify is shipped, so they
# describe the past rather than the code, and a reader who finds them in the
# repository has to work out which one is still true. Kept locally, not here.
/PROMPT.md
/PLAN.md
/PROGRESS.md
/ACCEPTANCE.md

# Local config overrides
config.local.yaml
.env
.env.local
/web/*.tsbuildinfo
