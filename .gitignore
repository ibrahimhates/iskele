# Build output
/bin/
/dist/
# The binary when built into the repo root. Anchored so it cannot swallow
# cmd/iskeled/.
/iskeled

# Frontend
/web/node_modules/
/web/dist/*
!/web/dist/.gitkeep
/web/.vite/

# Documentation site. `build` is site/ with the repository's Markdown copied in
# and front matter added; `_site` is what Jekyll renders from it. Both are
# produced by .github/workflows/pages.yml and neither belongs in the tree.
/build/
/_site/
/.jekyll-cache/

# Test & coverage
*.out
*.test
coverage.html

# Local runtime data
/.data/
*.db
*.db-wal
*.db-shm
secret.key

# Editors / OS
.idea/
.vscode/
*.swp
.DS_Store

# Local config overrides
config.local.yaml
.env
.env.local
/web/*.tsbuildinfo
